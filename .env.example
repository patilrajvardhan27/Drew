# Copy this file to .env in the repo root. .env is git-ignored and never leaves your machine.
# "fixture" runs without Adobe; "live" needs the two credentials below.
REDRAFT_ADOBE_MODE=fixture

# From the Adobe Developer Console: your project > PDF Services API > OAuth Server-to-Server.
# Adobe's own names (PDF_SERVICES_CLIENT_ID / PDF_SERVICES_CLIENT_SECRET) work too.
REDRAFT_ADOBE_CLIENT_ID=
REDRAFT_ADOBE_CLIENT_SECRET=

# Signs links for the Adobe Express add-on. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDRAFT_SECRET_KEY=

# Set to true when served over HTTPS so the sign-in cookie is never sent in plain text.
REDRAFT_SECURE_COOKIES=false

# Password reset emails. "log" prints them, "file" saves them to data/files/mail, "smtp" sends them.
REDRAFT_MAIL_BACKEND=log
REDRAFT_PUBLIC_URL=
REDRAFT_SMTP_HOST=
REDRAFT_SMTP_PORT=587
REDRAFT_SMTP_USER=
REDRAFT_SMTP_PASSWORD=
REDRAFT_SMTP_FROM=Redraft <no-reply@example.com>

REDRAFT_DATABASE_URL=sqlite:///./data/redraft.db
REDRAFT_STORAGE_DIR=./data/files
